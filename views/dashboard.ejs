<%- include('partials/header') %>

<h1>Dashboard</h1>

<section class="site-status">
  <h2>Your site: <a href="<%= site.url %>"><%= cuteUrl %></a></h2>
  <p>
    Status:
    <% if (site.active) { %>
      <span class="status-badge active">Active</span>
    <% } else { %>
      <span class="status-badge inactive">Inactive</span>
    <% } %>
  </p>
  <% if (site.status === 'pending') { %>
    <p class="status-notice pending-notice">Your site is awaiting admin approval. Once approved, it will appear in the ring.</p>
  <% } else if (site.status === 'denied') { %>
    <p class="status-notice denied-notice">Your site has been denied entry to the ring. Please contact an admin if you believe this is an error.</p>
  <% } else if (site.status === 'banned') { %>
    <p class="status-notice banned-notice">Your site has been banned from the ring.</p>
  <% } %>
</section>

<% if (site.profile) { %>
<section class="profile-preview">
  <h2>Your profile</h2>
  <%- include('partials/profile', { profile: site.profile, url: site.url, cuteUrl: cuteUrl }) %>
</section>
<% } %>

<section class="actions">
  <h2>Webring links</h2>
  <p>Add these links to your site to join the ring:</p>
  <%- include('partials/code-block') %>

  <div class="action-buttons">
    <form method="POST" action="/check-links">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <button type="submit" class="btn">Check links</button>
    </form>

    <form method="POST" action="/check-profile">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-secondary">Check profile</button>
    </form>

    <% if (site.profile) { %>
    <form method="POST" action="/remove-profile">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-danger">Remove profile</button>
    </form>
    <% } %>
  </div>
</section>

<% if (checks.length > 0) { %>
<section class="checks-history">
  <h2>Recent checks</h2>
  <%- include('partials/site-checks', { checks: checks }) %>
</section>
<% } %>

<section class="nav-stats">
  <h2>Navigation stats</h2>
  <p class="hits-total-large"><%= hits.total %></p>
  <p class="nav-stats-label">total webring navigations from your site</p>
  <% if (hits.total > 0) { %>
    <div class="hits-breakdown-large">
      <span title="Previous">&larr; <%= hits.previous %></span>
      <span title="Next">&rarr; <%= hits.next %></span>
      <span title="Random">&#x21af; <%= hits.random %></span>
      <span title="Home">&#x2302; <%= hits.home %></span>
    </div>
  <% } %>
</section>

<section class="logout">
  <form method="POST" action="/auth/logout">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <button type="submit" class="btn btn-secondary">Sign out</button>
  </form>
</section>

<%- include('partials/footer') %>
