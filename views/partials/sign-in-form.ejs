<form method="POST" action="/auth/login" class="sign-in-form">
  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
  <label for="url">Your domain:</label>
  <div class="input-group">
    <input type="url" id="url" name="url" placeholder="https://example.com" required autocomplete="url" maxlength="2048" class="url-input">
    <button type="submit" class="btn">Sign in</button>
  </div>
</form>
