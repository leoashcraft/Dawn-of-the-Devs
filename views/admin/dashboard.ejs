<%- include('../partials/header') %>

<h1>Admin Dashboard</h1>

<section class="webring-config">
  <h2>Webring Configuration</h2>
  <form method="POST" action="/admin/config" class="config-form">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    
    <div class="config-group">
      <h3>Home Link</h3>
      <div class="form-row">
        <label for="homeText">Link Text:</label>
        <input type="text" id="homeText" name="homeText" value="<%= webringConfig.homeText %>" class="url-input">
      </div>
      <div class="form-row">
        <label for="homeLabel">aria-label:</label>
        <input type="text" id="homeLabel" name="homeLabel" value="<%= webringConfig.homeLabel %>" class="url-input">
      </div>
      <div class="form-row">
        <label for="homeTitle">title:</label>
        <input type="text" id="homeTitle" name="homeTitle" value="<%= webringConfig.homeTitle %>" class="url-input">
      </div>
    </div>

    <div class="config-group">
      <h3>Previous Link</h3>
      <div class="form-row">
        <label for="previousLabel">aria-label:</label>
        <input type="text" id="previousLabel" name="previousLabel" value="<%= webringConfig.previousLabel %>" class="url-input">
      </div>
      <div class="form-row">
        <label for="previousTitle">title:</label>
        <input type="text" id="previousTitle" name="previousTitle" value="<%= webringConfig.previousTitle %>" class="url-input">
      </div>
    </div>

    <div class="config-group">
      <h3>Next Link</h3>
      <div class="form-row">
        <label for="nextLabel">aria-label:</label>
        <input type="text" id="nextLabel" name="nextLabel" value="<%= webringConfig.nextLabel %>" class="url-input">
      </div>
      <div class="form-row">
        <label for="nextTitle">title:</label>
        <input type="text" id="nextTitle" name="nextTitle" value="<%= webringConfig.nextTitle %>" class="url-input">
      </div>
    </div>

    <div class="config-group">
      <h3>Random Link</h3>
      <div class="form-row">
        <label for="randomLabel">aria-label:</label>
        <input type="text" id="randomLabel" name="randomLabel" value="<%= webringConfig.randomLabel %>" class="url-input">
      </div>
      <div class="form-row">
        <label for="randomTitle">title:</label>
        <input type="text" id="randomTitle" name="randomTitle" value="<%= webringConfig.randomTitle %>" class="url-input">
      </div>
    </div>

    <button type="submit" class="btn">Save Configuration</button>
  </form>
</section>

<section class="admin-stats">
  <div class="stat-pills">
    <a href="/admin" class="stat-pill <%= !currentFilter ? 'active' : '' %>">
      All <span class="stat-count"><%= counts.total %></span>
    </a>
    <a href="/admin?filter=pending" class="stat-pill pending <%= currentFilter === 'pending' ? 'active' : '' %>">
      Pending <span class="stat-count"><%= counts.pending %></span>
    </a>
    <a href="/admin?filter=approved" class="stat-pill approved <%= currentFilter === 'approved' ? 'active' : '' %>">
      Approved <span class="stat-count"><%= counts.approved %></span>
    </a>
    <a href="/admin?filter=denied" class="stat-pill denied <%= currentFilter === 'denied' ? 'active' : '' %>">
      Denied <span class="stat-count"><%= counts.denied %></span>
    </a>
    <a href="/admin?filter=banned" class="stat-pill banned <%= currentFilter === 'banned' ? 'active' : '' %>">
      Banned <span class="stat-count"><%= counts.banned %></span>
    </a>
  </div>
</section>

<% if (sites.length === 0) { %>
  <p>No sites found<%= currentFilter ? ' with status "' + currentFilter + '"' : '' %>.</p>
<% } else { %>
<section class="admin-sites">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Site</th>
        <th>Status</th>
        <th>Active</th>
        <th>Joined</th>
        <th>Hits</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% sites.forEach(function(site) { %>
        <tr>
          <td><a href="<%= site.url %>" target="_blank" rel="noopener"><%= site.cuteUrl %></a></td>
          <td>
            <span class="status-badge mod-<%= site.status %>"><%= site.status %></span>
          </td>
          <td>
            <% if (site.active) { %>
              <span class="status-badge active">active</span>
            <% } else { %>
              <span class="status-badge inactive">inactive</span>
            <% } %>
          </td>
          <td class="time-ago"><%= site.timeAgo %></td>
          <td class="hits-cell">
            <span class="hits-total"><%= site.hits.total %></span>
            <span class="hits-breakdown">
              <span title="Previous">&larr; <%= site.hits.previous %></span>
              <span title="Next">&rarr; <%= site.hits.next %></span>
              <span title="Random">&#x21af; <%= site.hits.random %></span>
              <span title="Home">&#x2302; <%= site.hits.home %></span>
            </span>
          </td>
          <td class="admin-actions">
            <% if (site.status !== 'approved') { %>
              <form method="POST" action="/admin/status" class="inline-form">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <input type="hidden" name="url" value="<%= site.url %>">
                <input type="hidden" name="status" value="approved">
                <button type="submit" class="btn btn-small btn-approve">Approve</button>
              </form>
            <% } %>
            <% if (site.status !== 'denied') { %>
              <form method="POST" action="/admin/status" class="inline-form">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <input type="hidden" name="url" value="<%= site.url %>">
                <input type="hidden" name="status" value="denied">
                <button type="submit" class="btn btn-small btn-deny">Deny</button>
              </form>
            <% } %>
            <% if (site.status !== 'banned') { %>
              <form method="POST" action="/admin/status" class="inline-form">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                <input type="hidden" name="url" value="<%= site.url %>">
                <input type="hidden" name="status" value="banned">
                <button type="submit" class="btn btn-small btn-ban">Ban</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<% } %>

<%- include('../partials/footer') %>
