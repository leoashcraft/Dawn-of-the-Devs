<%- include('partials/header') %>

<section class="hero">
  <img src="/img/dawnofthedev.jpeg" alt="Dawn of the Devs" class="hero-logo">
  <h1>Dawn of the Devs</h1>
  <p class="tagline">An IndieWeb webring for web developer portfolios.</p>
</section>

<section class="what">
  <h2>What is this?</h2>
  <p>
    Dawn of the Devs is a <a href="https://indieweb.org/webring">webring</a> for web developer portfolios.
    Members link their sites together so visitors can discover developers
    by clicking next, previous, random &mdash; no algorithms, no tracking,
    no ranking. Just human-made sites, linked together.
  </p>
  <p>
    <a href="/random" class="btn">Visit a random member</a>
    <a href="/directory" class="btn btn-secondary">Browse the directory</a>
  </p>
</section>

<section class="join">
  <h2>Join the ring</h2>
  <p>
    To join, add these links somewhere on your site, then sign in with your domain:
  </p>
  <%- include('partials/code-block') %>

  <% if (!user) { %>
    <%- include('partials/sign-in-form') %>
    <p class="indieauth-hint">
      Sign-in uses <a href="https://indieauth.net/" target="_blank" rel="noopener">IndieAuth</a>.
      You'll need an authorization endpoint on your domain &mdash;
      <a href="https://indielogin.com/setup" target="_blank" rel="noopener">set one up</a> if you haven't already.
    </p>
  <% } else { %>
    <p>You are signed in as <strong><%= user.url %></strong>. <a href="/dashboard">Go to dashboard</a>.</p>
  <% } %>
</section>

<% if (recentSites.length > 0) { %>
<section class="recent">
  <h2>Recent members</h2>
  <ul class="recent-list">
    <% recentSites.forEach(function(site) { %>
      <li>
        <a href="<%= site.url %>"><%= site.cuteUrl %></a>
        <span class="time-ago"><%= site.timeAgo %></span>
        <% if (site.active) { %>
          <span class="status-badge active">active</span>
        <% } else { %>
          <span class="status-badge inactive">inactive</span>
        <% } %>
      </li>
    <% }); %>
  </ul>
</section>
<% } %>

<%- include('partials/footer') %>
