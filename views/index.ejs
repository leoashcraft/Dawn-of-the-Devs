<%- include('partials/header') %>

<section class="hero">
  <img src="/img/dawnofthedev.jpeg" alt="Dawn of the Devs" class="hero-logo">
  <h1>Dawn of the Devs</h1>
  <p class="tagline">An IndieWeb webring for web developer portfolios.</p>
</section>

<section class="what">
  <h2>What is this?</h2>
  <p>
    Dawn of the Devs is a <a href="https://indieweb.org/webring">webring</a> for web developer portfolios.
    Members link their sites together so visitors can discover developers
    by clicking next, previous, random &mdash; no algorithms, no tracking,
    no ranking. Just human-made sites, linked together.
  </p>
  <p>
    <a href="/random" class="btn">Visit a random member</a>
    <a href="/directory" class="btn btn-secondary">Browse the directory</a>
  </p>
</section>

<section class="join">
  <h2>Join the ring</h2>
  <p>
    To join, add these links somewhere on your site, then sign in with your domain:
  </p>
  <%- include('partials/code-block') %>

  <% if (!user) { %>
    <% if (indieAuthError) { %>
      <div class="flash flash-error">
        <%= indieAuthError.message %>
      </div>
    <% } %>
    <%- include('partials/sign-in-form') %>
    <p class="indieauth-hint">
      Sign-in uses <a href="https://indieauth.net/" target="_blank" rel="noopener">IndieAuth</a>.
      You'll need an authorization endpoint on your domain &mdash;
      <a href="https://indielogin.com/setup" target="_blank" rel="noopener">set one up</a> if you haven't already.
    </p>
    <% } else { %>
    <p>You are signed in as <strong><%= user.url %></strong>. <a href="/dashboard">Go to dashboard</a>.</p>
    <% } %>
</section>

<% if (recentSites.length > 0) { %>
<section class="recent">
  <h2>Recent members</h2>
  <ul class="recent-list">
    <% recentSites.forEach(function(site) { %>
      <li>
        <a href="<%= site.url %>"><%= site.cuteUrl %></a>
        <span class="time-ago"><%= site.timeAgo %></span>
        <% if (site.active) { %>
          <span class="status-badge active">active</span>
        <% } else { %>
          <span class="status-badge inactive">inactive</span>
        <% } %>
      </li>
    <% }); %>
  </ul>
</section>
<% } %>

<section class="open-source-banner">
  <a href="https://github.com/leoashcraft/Dawn-of-the-Devs" target="_blank" rel="noopener" class="open-source-link">
    <svg class="github-logo" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
    <span class="open-source-text">
      <strong>Transparent &amp; open source</strong>
      <span>All code is publicly available for review on GitHub</span>
    </span>
    <span class="open-source-arrow">&rarr;</span>
  </a>
</section>

<%- include('partials/footer') %>
